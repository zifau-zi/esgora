# Base URL API default = relative "/api".
#   - Dev local: diproxy Vite ke http://localhost:3000 (lihat vite.config.js).
#   - Produksi Netlify: diproxy oleh netlify.toml ke URL backend publik
#     (ganti URL di netlify.toml dengan alamat backend temen kalian).
#
# Kalau mau backend di host terpisah dengan URL mutlak, set di dashboard
# Netlify (Environment variables) lalu rebuild:
#   VITE_API_BASE_URL=https://backend-url-kalian/api
VITE_API_BASE_URL=/api

# Set "false" jika ingin langsung memakai API backend asli (bukan data dummy)
VITE_USE_MOCK=false